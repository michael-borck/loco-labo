        { "id": "agente", "label": "The robot workshop: LocoAgente", "url": "https://locoagente.org/" },
        { "id": "convoy", "label": "The mountain road: LocoConvoy", "url": "https://lococonvoy.org/" },
        { "id": "puente", "label": "The bridge: LocoPuente", "url": "https://locopuente.org/" },
        { "id": "musa", "label": "The observatory: LocoMusa", "url": "https://locomusa.org/" },
        { "id": "ensayo", "label": "The theatre: LocoEnsayo", "url": "https://locoensayo.org/" },
        { "id": "notas", "label": "The library: LocoNotas", "url": "https://loconotas.org/" }
