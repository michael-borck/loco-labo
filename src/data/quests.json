        { "id": "scenario", "label": "Walk through a rehearsal scenario", "url": "https://locoensayo.org/cloudcore/" },
        { "id": "educators", "label": "Read the guide for educators", "url": "https://locoensayo.org/for-educators/" },
        { "id": "capstone", "label": "See what student teams build", "url": "https://locolabo.org/capstone/" }
