      "steps": [
        { "id": "contract", "label": "Read the result contract", "url": "https://locobanco.org/result-contract/" },
        { "id": "guide", "label": "Follow the benchmarking guide", "url": "https://locobanco.org/guide/" },
        { "id": "measure", "label": "Measure your card: three runs, median, wall power", "manual": true },
        { "id": "notes", "label": "See how failures get written up in LocoNotas", "url": "https://loconotas.org/notes/" },
        { "id": "submit", "label": "Open an issue with your run and source_run_id", "url": "https://github.com/michael-borck/loco-banco/issues" }
      ],
      "badge": { "name": "Cartographer", "text": "Added a measured point to the map of the floor" }
    },
