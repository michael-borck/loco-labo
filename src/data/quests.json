      "steps": [
        { "id": "cc", "label": "Find your card's compute capability", "url": "https://locofosil.org/hardware/" },
        { "id": "driver", "label": "Pick the right driver branch for it", "url": "https://locofosil.org/setup/#one-host-one-driver-branch" },
        { "id": "build", "label": "See what a $150 build can run", "url": "https://locofosil.org/builds/" },
        { "id": "kindi", "label": "Install Kindi and run kindi verify", "url": "https://github.com/ahtx/kindi" },
        { "id": "targets", "label": "Compare your speed with the validation targets", "url": "https://locofosil.org/setup/#validation-targets" }
      ],
      "badge": { "name": "Fossil Hunter", "text": "Woke a GPU the modern stack left behind" }
    },
    {
      "id": "find-your-tier",
      "title": "Find your tier",
