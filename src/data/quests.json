      "steps": [
        { "id": "why", "label": "Read why local AI matters", "url": "https://locolabo.org/why-local-ai/" },
        { "id": "tools", "label": "Pick a tool from the local LLM tools guide", "url": "https://locolabo.org/local-llm-tools/" },
        { "id": "model", "label": "Choose a model that fits your machine", "url": "https://locolabo.org/ollama-model-guide/" },
        { "id": "run", "label": "Run it and ask it something you actually care about", "manual": true },
        { "id": "puente", "label": "See how LocoPuente serves a whole class from one box", "url": "https://locopuente.org/" }
      ],
      "badge": { "name": "Lamplighter", "text": "Ran a model on hardware you own" }
    },
    {
      "id": "wake-a-fossil",
      "title": "Wake a fossil",
