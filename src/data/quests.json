      "steps": [
        { "id": "tiers", "label": "Learn how VRAM tiers work", "url": "https://locobanco.org/tiers/" },
        { "id": "picker", "label": "Plot your card in the GPU Picker", "url": "https://locobanco.org/picker/" },
        { "id": "quality", "label": "Compare model quality at your tier", "url": "https://locobanco.org/quality/" },
        { "id": "bang", "label": "Weigh speed against quality: bang per bit", "url": "https://locobanco.org/bang-per-bit/" },
        { "id": "registry", "label": "Check whether the lab owns your card", "url": "https://locolabo.org/gpu-registry/" }
      ],
      "badge": { "name": "Tier Scout", "text": "Matched a model to a VRAM budget" }
    },
    {
      "id": "leave-your-mark",
      "title": "Leave your mark",
      "subtitle": "Contribute a measured result",
      "icon": "picker",
      "for": "contribute",
